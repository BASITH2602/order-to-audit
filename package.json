{
  "name": "order-to-audit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:bootstrap": "tsx --env-file=.env prisma/bootstrap.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "demo:setup": "prisma db push && tsx --env-file=.env prisma/bootstrap.ts && tsx --env-file=.env prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/gst.test.ts tests/units.test.ts tests/gstin.test.ts tests/reports.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
