# --- Real installation (copy to .env) ---
POSTGRES_PASSWORD=""            # choose a strong password
# at least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=""
COMPANY_NAME=""
COMPANY_GSTIN=""
COMPANY_STATE_CODE=""           # e.g. 33
COMPANY_STATE_NAME=""           # e.g. Tamil Nadu
ADMIN_USERNAME=""
ADMIN_PASSWORD=""               # at least 12 characters
APP_URL=""                      # public base URL, used in invoice share links (optional)
COOKIE_SECURE=""                # set "false" only when serving over plain http

# --- Local development without Docker for the app (DB from docker compose) ---
DATABASE_URL="postgresql://ota:ota@localhost:5432/ota"

# --- Benchmark only ---
LOAD_BENCHMARK_SEED="false"
BENCHMARK_PASSWORD=""
